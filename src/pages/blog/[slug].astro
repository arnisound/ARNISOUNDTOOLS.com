---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/site';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => p.data.statut === 'publie');
  return posts.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, keywords } = entry.data;

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
const readMin = Math.max(1, Math.round((entry.body ?? '').split(/\s+/).length / 200));
const niceTitle = (t: string) => t.replace(/ ([:;!?])/g, ' $1');
const cover = `/blog/covers/${entry.data.slug}.webp`;

// Appel à l'action spécifique à chaque article (destination + texte).
type CtaTool = { slug: string; label: string };
type Cta = { title: string; text: string; tools: CtaTool[] };
const CTA: Record<string, Cta> = {
  'micros-hf-gresillent-decrochent': {
    title: 'Partez d’un plan de fréquences propre',
    text: 'Neuf soucis HF sur dix viennent du plan de fréquences. Speed RF en calcule un fiable pour votre matériel et votre ville ; RF Shot va plus loin sur les grosses configurations.',
    tools: [
      { slug: 'speed-rf', label: 'Découvrir Speed RF' },
      { slug: 'rf-shot', label: 'Voir RF Shot' },
    ],
  },
  'frequences-micro-hf-france-guide': {
    title: 'Des fréquences propres, sans prise de tête',
    text: 'Speed RF choisit pour vous des fréquences autorisées et compatibles, en tenant compte de la TNT locale et des bandes PMSE françaises.',
    tools: [{ slug: 'speed-rf', label: 'Découvrir Speed RF' }],
  },
  'intermodulation-expliquee-simplement': {
    title: 'Laissez RF Shot coordonner vos fréquences',
    text: 'Calculer les intermodulations à la main devient vite impossible. RF Shot coordonne 100+ fréquences et vérifie les produits jusqu’à l’ordre 7, plus les combinaisons à trois émetteurs.',
    tools: [{ slug: 'rf-shot', label: 'Découvrir RF Shot' }],
  },
  'calculer-delay-enceinte-methode': {
    title: 'Calculez vos delays en un geste',
    text: 'AV Calc réunit le calcul du delay, la vitesse du son selon la température et plus de 70 autres calculateurs de terrain. Gratuit, directement dans le navigateur.',
    tools: [{ slug: 'av-calc', label: 'Ouvrir AV Calc' }],
  },
  'creer-fiche-technique-spectacle': {
    title: 'Créez une fiche technique claire et exportable',
    text: 'Fiche Tech Creator génère des fiches structurées (son, lumière, plateau) et les exporte en PDF propre, sans se battre avec la mise en page. Gratuit.',
    tools: [{ slug: 'fiche-tech', label: 'Ouvrir Fiche Tech Creator' }],
  },
};
const cta: Cta = CTA[entry.data.slug] ?? {
  title: 'Passez à la pratique',
  text: 'Découvrez les outils Arnisound pour gagner du temps sur le terrain.',
  tools: [{ slug: 'speed-rf', label: 'Découvrir les outils' }],
};

const SITE = 'https://arnisoundtools.com';
const canonical = `${SITE}/blog/${entry.data.slug}/`;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString().slice(0, 10),
  dateModified: date.toISOString().slice(0, 10),
  inLanguage: 'fr-FR',
  keywords: keywords.join(', '),
  mainEntityOfPage: canonical,
  url: canonical,
  author: { '@type': 'Organization', name: 'Arnisound Tools', url: SITE },
  publisher: {
    '@type': 'Organization',
    name: 'Arnisound Tools',
    url: SITE,
    logo: { '@type': 'ImageObject', url: `${SITE}/logo.svg` },
  },
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE}/blog/` },
    { '@type': 'ListItem', position: 3, name: title, item: canonical },
  ],
};
---

<Base title={`${title} | Arnisound Tools`} description={description} image={cover}>
  <article class="section blog-article">
    <div class="container">
      <nav class="crumbs" aria-label="Fil d'Ariane">
        <a href={url('/')}>Accueil</a>
        <span aria-hidden="true">/</span>
        <a href={url('/blog')}>Blog</a>
      </nav>

      <header class="blog-article__head">
        <span class="eyebrow">Guide du terrain</span>
        <h1>{niceTitle(title)}</h1>
        <p class="blog-article__lead">{description}</p>
        <div class="blog-article__meta">
          <time datetime={date.toISOString().slice(0, 10)}>{fmt(date)}</time>
          <span aria-hidden="true">·</span>
          <span>{readMin} min de lecture</span>
        </div>
      </header>

      <figure class="blog-article__cover">
        <img src={url(cover)} alt={'Illustration : ' + title} width="1200" height="675" />
      </figure>

      <div class="prose">
        <Content />
      </div>

      <aside class="blog-article__cta card">
        <div>
          <h2>{cta.title}</h2>
          <p class="text-muted">{cta.text}</p>
        </div>
        <div class="blog-article__cta-actions">
          {cta.tools.map((t, i) => (
            <a href={url('/' + t.slug)} class:list={['btn', i === 0 ? 'btn--primary' : 'btn--ghost']}>{t.label}</a>
          ))}
          <a href={url('/blog')} class="btn btn--ghost">← Tous les articles</a>
        </div>
      </aside>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  <script is:inline>
    // Ajuste la hauteur des schémas interactifs (même origine) au contenu.
    (function () {
      function fit(frame) {
        try {
          const doc = frame.contentWindow.document;
          const h = Math.ceil(doc.documentElement.getBoundingClientRect().height);
          if (h > 0) frame.style.height = h + 'px';
        } catch (e) {}
      }
      document.querySelectorAll('iframe.schema-embed').forEach((frame) => {
        const run = () => {
          fit(frame);
          try {
            const ro = new ResizeObserver(() => fit(frame));
            ro.observe(frame.contentWindow.document.body);
          } catch (e) {}
        };
        if (frame.contentDocument && frame.contentDocument.readyState === 'complete') run();
        frame.addEventListener('load', run);
      });
    })();
  </script>
</Base>

<style>
  .blog-article { padding-top: 2rem; }
  .container { max-width: 820px; }

  .crumbs {
    display: flex; gap: 0.5rem; align-items: center;
    font-size: 0.85rem; color: var(--text-faint); margin-bottom: 1.5rem;
  }
  .crumbs a { color: var(--text-muted); }
  .crumbs a:hover { color: var(--accent); }

  .blog-article__head { margin-bottom: 2rem; }
  .blog-article__head h1 {
    margin-top: 0.75rem; font-size: clamp(1.7rem, 4vw, 2.5rem); line-height: 1.15;
    text-wrap: balance;
  }

  .blog-article__cover {
    margin: 0 0 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: #0d0d10;
    aspect-ratio: 16 / 9;
  }
  .blog-article__cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .blog-article__lead {
    margin-top: 1rem; font-size: 1.12rem; line-height: 1.6; color: var(--text-muted);
  }
  .blog-article__meta {
    margin-top: 1.1rem; display: flex; gap: 0.5rem; align-items: center;
    font-size: 0.85rem; color: var(--text-faint);
  }

  /* ---------- Corps de l'article ---------- */
  .prose { font-size: 1.05rem; line-height: 1.75; color: var(--text); }
  .prose :global(h2) {
    margin: 2.6rem 0 0.9rem; font-size: 1.45rem; line-height: 1.25;
    padding-top: 1.6rem; border-top: 1px solid var(--border);
  }
  .prose :global(h3) { margin: 1.8rem 0 0.6rem; font-size: 1.15rem; color: var(--text); }
  .prose :global(p) { margin: 0 0 1.1rem; color: var(--text-muted); }
  .prose :global(strong) { color: var(--text); font-weight: 600; }
  .prose :global(em) { color: var(--text); }
  .prose :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .prose :global(a:hover) { color: var(--accent-hover); }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.2rem; padding-left: 1.3rem; color: var(--text-muted); }
  .prose :global(li) { margin: 0.35rem 0; }
  .prose :global(li::marker) { color: var(--accent); }

  .prose :global(blockquote) {
    margin: 1.4rem 0; padding: 0.9rem 1.2rem;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft); border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--text-muted);
  }
  .prose :global(blockquote p) { margin: 0; }

  .prose :global(hr) { border: none; border-top: 1px solid var(--border); margin: 2.4rem 0; }

  .prose :global(table) {
    width: 100%; border-collapse: collapse; margin: 1.4rem 0; font-size: 0.95rem;
    display: block; overflow-x: auto;
  }
  .prose :global(th), .prose :global(td) {
    border: 1px solid var(--border); padding: 0.6rem 0.8rem; text-align: left;
  }
  .prose :global(th) { background: var(--bg-soft); color: var(--text); }
  .prose :global(td) { color: var(--text-muted); }

  .prose :global(code) {
    font-family: 'JetBrains Mono', monospace; font-size: 0.88em;
    background: var(--bg-soft); border: 1px solid var(--border);
    border-radius: 6px; padding: 0.1em 0.4em;
  }

  /* Schémas interactifs intégrés */
  .prose :global(figure.schema) { margin: 2rem 0; }
  .prose :global(.schema-embed) {
    width: 100%; border: 1px solid var(--border); border-radius: var(--radius);
    background: #0c0c0e; min-height: 460px; display: block;
  }
  .prose :global(figure.schema figcaption) {
    margin-top: 0.6rem; font-size: 0.82rem; color: var(--text-faint); text-align: center;
  }

  /* ---------- CTA de fin ---------- */
  .blog-article__cta {
    margin-top: 3rem; padding: 2rem;
    display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap;
  }
  .blog-article__cta h2 { font-size: 1.2rem; }
  .blog-article__cta p { margin-top: 0.4rem; max-width: 46ch; }
  .blog-article__cta-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }
</style>
