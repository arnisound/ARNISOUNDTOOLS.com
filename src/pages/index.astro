---
import Base from '../layouts/Base.astro';
import { products, bundle } from '../data/products';
import { url } from '../lib/site';
import { checkoutLive, checkoutUrl } from '../lib/checkout';
import { getCollection } from 'astro:content';

// 3 derniers articles publiés (maillage interne vers le blog).
const niceTitle = (t: string) => t.replace(/ ([:;!?])/g, ' $1');
const latestPosts = (await getCollection('blog'))
  .filter((p) => p.data.statut === 'publie')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// Bouton du bundle : checkout Lemon Squeezy si la boutique est active,
// sinon repli sur /login (le script client ajoute email + user_id si connecté).
const bundleCheckout = checkoutLive && Boolean(bundle.checkoutId);
const bundleHref = bundleCheckout ? checkoutUrl(bundle.checkoutId!) : url('/login');

// Données structurées : identité de la marque + site (SEO).
const orgSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://arnisoundtools.com/#organization',
      name: 'Arnisound Tools',
      url: 'https://arnisoundtools.com',
      logo: 'https://arnisoundtools.com/favicon-512.png',
      email: 'contact@arnisoundtools.com',
      slogan: 'Les outils du terrain, par des gens du terrain.',
      description:
        "Outils web pour le spectacle vivant, l'audiovisuel et l'événementiel : son, lumière, vidéo, régie.",
    },
    {
      '@type': 'WebSite',
      '@id': 'https://arnisoundtools.com/#website',
      name: 'Arnisound Tools',
      url: 'https://arnisoundtools.com',
      inLanguage: 'fr-FR',
      publisher: { '@id': 'https://arnisoundtools.com/#organization' },
    },
  ],
};

// Ordre d'affichage : les 2 outils RF (phares) d'abord, puis les gratuits,
// et Repérages (bientôt) en dernier.
const order = ['speed-rf', 'rf-shot', 'av-calc', 'fiche-tech', 'timestage', 'reperages'];
const outils = order
  .map((slug) => products.find((p) => p.slug === slug))
  .filter((p): p is (typeof products)[number] => Boolean(p));
---

<Base>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="container hero__inner">
      <span class="eyebrow">Spectacle vivant · Audiovisuel · Événementiel</span>
      <h1>Les outils de terrain,<br />efficaces et rapides.</h1>
      <p class="lead">
        Une suite d'outils web pros pour le son, la lumière, la vidéo et la régie.
        Simples, en français, accessibles partout — sans installation.
      </p>
      <div class="hero__cta">
        <a href="#outils" class="btn btn--primary">Découvrir les outils</a>
        <a href={url('/login')} class="btn btn--ghost">Créer un compte gratuit</a>
      </div>
      <p class="hero__note text-muted">
        Pas de logiciel à installer · fonctionne sur mobile · pensé pour la régie
      </p>
    </div>
    <div class="hero__glow" aria-hidden="true"></div>
  </section>

  <!-- ===================== OUTILS ===================== -->
  <section id="outils" class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">Les outils</span>
        <h2>Une boîte à outils, un même esprit</h2>
        <p class="lead">Faire gagner du temps sur le terrain. Rien de superflu.</p>
      </header>

      <div class="grid grid--3" style="margin-top: 2.5rem;">
        {outils.map((p) => (
          <a href={url(`/${p.slug}`)} class="card product-card">
            <div class="product-card__head">
              {p.image && (
                <img src={url(p.image)} alt={`Logo ${p.name}`} class="product-card__logo" width="54" height="54" loading="lazy" />
              )}
              {p.free ? (
                <span class="badge badge--free">Gratuit</span>
              ) : p.comingSoon ? (
                <span class="badge">Bientôt</span>
              ) : (
                <span class="badge">{p.price}</span>
              )}
            </div>
            <h3 class="product-card__name">{p.name}</h3>
            <p class="text-muted">{p.tagline}</p>
            <span class="product-card__link">Voir l'outil →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== BUNDLE ===================== -->
  <section class="section section--wood" style={`--wood-img: url(${url('/textures/wood.jpg')})`}>
    <div class="container">
      <div class="bundle card">
        <div>
          <span class="eyebrow">Offre</span>
          <h2>{bundle.name}</h2>
          <p class="lead">{bundle.note}</p>
        </div>
        <div class="bundle__price">
          <span class="bundle__was">{bundle.was}</span>
          <span class="bundle__now">{bundle.price}</span>
          <a href={bundleHref} class="btn btn--primary" {...(bundleCheckout ? { 'data-checkout': true } : {})}>Profiter du bundle</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== POURQUOI ===================== -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">Pourquoi Arnisound Tools ?</span>
        <h2>Conçu sur le terrain, pas en bureau d'études</h2>
      </header>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        <div class="card">
          <h3>En français</h3>
          <p class="text-muted">Le contexte réglementaire et le vocabulaire métier du secteur, dans votre langue.</p>
        </div>
        <div class="card">
          <h3>Sans installation</h3>
          <p class="text-muted">Tout tourne dans le navigateur, sur mobile comme sur ordi. Rien à installer.</p>
        </div>
        <div class="card">
          <h3>Prix justes</h3>
          <p class="text-muted">Pensés pour les budgets du terrain. Paiement unique, pas d'abonnement caché.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== BLOG ===================== -->
  {latestPosts.length > 0 && (
    <section class="section">
      <div class="container">
        <header class="section-head blog-teaser__head">
          <div>
            <span class="eyebrow">Le blog</span>
            <h2>Guides du terrain</h2>
            <p class="lead">Fréquences, intermodulation, calage des délais, fiche technique : nos guides pratiques et sourcés.</p>
          </div>
          <a href={url('/blog')} class="btn btn--ghost">Tous les articles →</a>
        </header>

        <div class="grid grid--3" style="margin-top: 2.5rem;">
          {latestPosts.map((post) => (
            <a href={url('/blog/' + post.data.slug)} class="card blog-teaser__card">
              <div class="blog-teaser__cover">
                <img src={url('/blog/covers/' + post.data.slug + '.webp')} alt={'Illustration : ' + post.data.title} width="1200" height="675" loading="lazy" />
              </div>
              <h3 class="blog-teaser__title">{niceTitle(post.data.title)}</h3>
              <p class="text-muted blog-teaser__excerpt">{post.data.description}</p>
              <span class="product-card__link">Lire l’article →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===================== CTA FINAL ===================== -->
  <section class="section section--soft">
    <div class="container text-center cta-final">
      <h2>Prêt à gagner du temps ?</h2>
      <p class="lead mx-auto">Créez votre compte gratuit : accédez à Fiche Tech et AV Calc, puis débloquez les outils RF quand vous voulez.</p>
      <a href={url('/login')} class="btn btn--primary" style="margin-top: 1.5rem;">Créer un compte gratuit</a>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
</Base>

<script>
  // Bouton « Acheter » (bundle) : ajoute l'email + le user_id du compte connecté
  // à l'URL de checkout. Non connecté → passage par /login d'abord.
  const nodes = document.querySelectorAll('a[data-checkout]');
  if (nodes.length) {
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    const { supabase } = await import('../lib/supabase');
    const { data: { session } } = await supabase.auth.getSession();
    nodes.forEach((node) => {
      const el = node as HTMLAnchorElement;
      const target = el.getAttribute('href') || '';
      if (session?.user) {
        const params = new URLSearchParams();
        params.set('checkout[email]', session.user.email ?? '');
        params.set('checkout[custom][user_id]', session.user.id);
        el.setAttribute('href', target + (target.includes('?') ? '&' : '?') + params.toString());
      } else {
        el.setAttribute('href', `${base}/login?next=${encodeURIComponent(target)}`);
      }
    });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 12vw, 8rem);
  }
  .hero__inner { position: relative; z-index: 1; max-width: 760px; }
  .hero h1 { margin-top: 1rem; }
  .hero .lead { margin-top: 1.25rem; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .hero__note { margin-top: 1.25rem; font-size: 0.88rem; }
  .hero__glow {
    position: absolute;
    top: -30%; right: -10%;
    width: 60vw; height: 60vw;
    max-width: 700px; max-height: 700px;
    background: radial-gradient(circle, var(--accent-soft), transparent 65%);
    pointer-events: none;
  }

  .section-head { max-width: 60ch; }
  .section-head h2 { margin-top: 0.75rem; }
  .section-head .lead { margin-top: 0.75rem; }

  .product-card { display: flex; flex-direction: column; gap: 0.6rem; }
  .product-card__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.3rem; }
  .product-card__logo { width: 54px; height: 54px; flex: none; filter: drop-shadow(0 4px 14px rgba(194, 131, 44, 0.18)); }
  .product-card__name { font-size: 1.25rem; }
  .product-card__link { margin-top: auto; color: var(--accent); font-weight: 600; font-size: 0.92rem; }

  .bundle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    padding: 2.5rem;
  }
  .bundle__price { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .bundle__was { color: var(--text-faint); text-decoration: line-through; }
  .bundle__now { font-size: 2rem; font-weight: 800; color: var(--accent); }

  .cta-final { max-width: 640px; }

  /* Teaser blog (home) */
  .blog-teaser__head {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 1.5rem; max-width: none; flex-wrap: wrap;
  }
  .blog-teaser__card { display: flex; flex-direction: column; gap: 0.6rem; padding: 0; overflow: hidden; }
  .blog-teaser__cover { aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--border); background: #0d0d10; }
  .blog-teaser__cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.35s ease; }
  .blog-teaser__card:hover .blog-teaser__cover img { transform: scale(1.04); }
  .blog-teaser__title { font-size: 1.1rem; line-height: 1.3; padding: 0 1.4rem; margin-top: 0.4rem; text-wrap: balance; }
  .blog-teaser__excerpt { padding: 0 1.4rem; font-size: 0.92rem; line-height: 1.55; }
  .blog-teaser__card .product-card__link { padding: 0 1.4rem 1.4rem; }
</style>
